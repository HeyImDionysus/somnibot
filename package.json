{
  "name": "somnibot",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/build-workspace.mjs",
    "lint": "node scripts/run-workspace-task.mjs lint",
    "type-check": "node scripts/run-workspace-task.mjs type-check",
    "clean": "node scripts/clean.mjs packages/shared/dist packages/bot/dist packages/dashboard/.next packages/dashboard/.turbo packages/e2e/dist packages/license-sdk/dist packages/launcher/dist",
    "bot:dev": "turbo dev --filter=@somnibot/bot",
    "dashboard:dev": "turbo dev --filter=@somnibot/dashboard",
    "db:migrate": "supabase db push --db-url $SUPABASE_DB_URL",
    "db:reset": "supabase db reset",
    "paypal:sandbox-pass": "node scripts/paypal-sandbox-pass.mjs",
    "paypal:sandbox-pass:test": "node --test scripts/paypal-sandbox-pass.test.mjs",
    "discord:live-readback": "node scripts/discord-live-readback.mjs",
    "docker:dev": "docker compose up -d",
    "docker:down": "docker compose down",
    "launcher:build": "node scripts/build-launcher.mjs",
    "launcher:build:win": "node scripts/build-launcher.mjs --win",
    "launcher:build:linux": "node scripts/build-launcher.mjs --linux",
    "launcher:build:all": "node scripts/build-launcher.mjs --all",
    "launcher:build:dir": "node scripts/build-launcher.mjs --dir"
  },
  "devDependencies": {
    "supabase": "2.110.0",
    "turbo": "^2.9.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-34x7-hfp2-rc4v",
        "GHSA-8qq5-rm4j-mr97",
        "GHSA-83g3-92jg-28cx",
        "GHSA-qffp-2rhf-9h96",
        "GHSA-9ppj-qmqm-q256",
        "GHSA-r6q2-hw4h-h46w",
        "GHSA-532v-xpq5-8h95",
        "GHSA-8337-3p73-46f4",
        "GHSA-jjp3-mq3x-295m",
        "GHSA-9wfr-w7mm-pc7f",
        "GHSA-5xrq-8626-4rwp",
        "GHSA-mh99-v99m-4gvg"
      ]
    },
    "overrides": {
      "esbuild": "0.28.1",
      "tmp": "0.2.7",
      "undici": "6.27.0",
      "ws": "8.21.0",
      "tar@>=7.0.0": ">=7.5.22 <8",
      "brace-expansion@>=2.0.0 <3.0.0": ">=2.1.4 <3",
      "brace-expansion@<2.0.0": ">=1.1.18 <2",
      "js-yaml@>=4.0.0 <5.0.0": ">=4.3.0 <5",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4 <4",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "next@>=13.0.0 <15.5.21": ">=15.5.21 <16",
      "builder-util-runtime@<9.7.0": ">=9.7.0 <10",
      "postcss@<8.5.18": ">=8.5.18 <9",
      "brace-expansion@>=5.0.0 <5.0.9": ">=5.0.9 <6"
    }
  }
}
