{
  "name": "somnibot",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "bot:dev": "turbo dev --filter=@somnibot/bot",
    "dashboard:dev": "turbo dev --filter=@somnibot/dashboard",
    "db:migrate": "supabase db push --db-url $SUPABASE_DB_URL",
    "db:reset": "supabase db reset",
    "docker:dev": "docker compose up -d",
    "docker:down": "docker compose down",
    "launcher:build": "node scripts/build-launcher.mjs",
    "launcher:build:win": "node scripts/build-launcher.mjs --win",
    "launcher:build:mac": "node scripts/build-launcher.mjs --mac",
    "launcher:build:linux": "node scripts/build-launcher.mjs --linux",
    "launcher:build:all": "node scripts/build-launcher.mjs --all",
    "launcher:build:dir": "node scripts/build-launcher.mjs --dir"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-34x7-hfp2-rc4v",
        "GHSA-8qq5-rm4j-mr97",
        "GHSA-83g3-92jg-28cx",
        "GHSA-qffp-2rhf-9h96",
        "GHSA-9ppj-qmqm-q256",
        "GHSA-r6q2-hw4h-h46w",
        "GHSA-532v-xpq5-8h95",
        "GHSA-8337-3p73-46f4",
        "GHSA-jjp3-mq3x-295m",
        "GHSA-9wfr-w7mm-pc7f"
      ]
    }
  }
}
