{
  "name": "@somnibot/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "type-check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e:deploy": "corepack pnpm --filter @somnibot/shared build && tsx e2e/deploy-live.e2e.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "clean": "node ../../scripts/clean.mjs dist"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.67",
    "@somnibot/shared": "workspace:*",
    "@supabase/auth-js": "^2.106.2",
    "@supabase/functions-js": "^2.106.2",
    "@supabase/postgrest-js": "^2.106.2",
    "@supabase/realtime-js": "^2.106.2",
    "@supabase/storage-js": "^2.106.2",
    "@supabase/supabase-js": "^2.49.0",
    "discord.js": "^14.24.0",
    "iovalkey": "^0.3.0",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.9",
    "shoukaku": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
