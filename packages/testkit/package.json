{
  "name": "@somnibot/testkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback-only, test-build-only E2E harness for driving the production interaction router. NEVER a production dependency of @somnibot/bot.",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@somnibot/bot": "workspace:*",
    "@somnibot/e2e": "workspace:*",
    "@types/node": "^22.0.0",
    "discord.js": "^14.24.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
