{
  "name": "@somnibot/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "SomniBot Desktop Launcher — download, configure, run.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "electron dist/main/index.js",
    "dev": "tsc && electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.7.0"
  }
}
