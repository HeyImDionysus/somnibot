{
  "name": "@somnibot/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "SomniBot Desktop Launcher \u2014 download, configure, run.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.preload.json && node -e \"require('node:fs').cpSync('src/renderer','dist/renderer',{recursive:true})\"",
    "start": "electron dist/main/index.js",
    "dev": "tsc && electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "clean": "node ../../scripts/clean.mjs dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
