# ============================================================
# SomniBot Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Discord (REQUIRED) ──────────────────────────────────────
# Get these from https://discord.com/developers/applications
#   → Your app → Bot → Token
#   → Your app → OAuth2 → Client ID and Client Secret
#   → Your app → Bot → Enable all 3 Privileged Gateway Intents
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=

# ── Supabase (REQUIRED) ─────────────────────────────────────
# Get these from https://supabase.com/dashboard
#   → Your project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auto-Configured (usually don't need to change) ──────────
# Guild ID is auto-detected when the bot joins your server
DISCORD_GUILD_ID=

# Lavalink (music server) — defaults work with docker compose
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Valkey (cache) — defaults work with docker compose
VALKEY_URL=redis://127.0.0.1:6379

# ── Dashboard ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Optional: PayPal (for commerce features) ────────────────
# Get these from https://developer.paypal.com → Dashboard → Apps
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=

# ── Optional: YouTube OAuth (for music) ─────────────────────
# Improves YouTube reliability. Get a refresh token from Lavalink's
# first-run OAuth URL (check Lavalink logs) or youfresh.thiranjaya.com
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Optional: Auto-Migration ────────────────────────────────
# If set, the bot auto-runs database migrations on first boot
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
