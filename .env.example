# ============================================================
# SomniBot Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Discord (REQUIRED) ──────────────────────────────────────
# Get these from https://discord.com/developers/applications
#   → Your app → Bot → Token
#   → Your app → OAuth2 → Client ID and Client Secret
#   → Your app → Bot → Enable all 3 Privileged Gateway Intents
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=

# ── Supabase (REQUIRED) ─────────────────────────────────────
# Get these from https://supabase.com/dashboard
#   → Your project → Settings → API
#   → Project URL and secret key (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Auto-Configured (usually don't need to change) ──────────
# Guild ID is auto-detected when the bot joins your server
DISCORD_GUILD_ID=
# Keep the bot health server separate from the dashboard PORT=3000 in regular local mode.
HEALTH_PORT=3001

# Lavalink (music server) — required before running start.sh/start.bat
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
# V5 Audit §9.P3c: Required — generate with: openssl rand -hex 16
LAVALINK_PASSWORD=

# Valkey (cache) — include password directly in the URL if requirepass is set.
# Shell interpolation (${VAR}) does NOT work in all .env parsers (dotenv, Docker).
# Examples:
#   No auth:   redis://127.0.0.1:6379
#   Docker/VPS with auth: redis://:yourpassword@valkey:6379
#   With auth: redis://:yourpassword@127.0.0.1:6379
VALKEY_URL=redis://127.0.0.1:6379
# Required by docker-compose.prod.yml when Valkey runs inside the VPS/private Docker network.
VALKEY_PASSWORD=

# ── Dashboard ────────────────────────────────────────────────
# Local/operator URL used by the bot when it points owners to the dashboard.
DASHBOARD_URL=http://localhost:3000
# Public dashboard/callback base used by setup, Supabase redirects, and PayPal webhooks.
# Regular local first run can use http://localhost:3000.
# Production local should use a stable HTTPS tunnel such as Tailscale Funnel.
# VPS should use the VPS domain, e.g. https://somnibot.example.com.
SOMNIBOT_PUBLIC_CALLBACK_BASE_URL=
# Build-time public app URL for the dashboard. The launcher sets this to the same
# value as SOMNIBOT_PUBLIC_CALLBACK_BASE_URL. Rebuild the dashboard after changing it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Number of trustworthy X-Forwarded-For entries visible to the dashboard.
# The generic default is 0: direct or unverified deployments must not trust a
# client-supplied header. Production Compose explicitly sets 1 because its
# shipped Caddy overwrites the header with one validated canonical address.
# For another proxy/tunnel, opt in only after verifying its exact header
# contract. Invalid values, short chains, and malformed addresses fail closed.
SOMNIBOT_TRUSTED_PROXY_HOPS=0
# Same as SUPABASE_URL above
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Security Secrets (REQUIRED for dashboard) ────────────────
# Generate each with: openssl rand -hex 32
CSRF_SECRET=
NEXTAUTH_SECRET=
WEBHOOK_REPLAY_SECRET=

# ── Optional: PayPal (for commerce features) ────────────────
# Get these from https://developer.paypal.com → Dashboard → Apps
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Set to <public-callback-base>/api/paypal/webhook when PayPal webhooks are enabled.
PAYPAL_WEBHOOK_URL=
# PayPal-truth reconciliation. The dashboard container runs this itself every
# 6h, so nothing below is required. The PayPal REST app needs the "Transaction
# Search" permission enabled or the pass will report a 403.
#   PAYPAL_RECONCILE_SECRET — optional. Set it to also allow an EXTERNAL
#     scheduler (host cron, systemd timer, uptime monitor) to trigger a pass:
#       curl -fsS -X POST -H "X-Reconcile-Secret: $PAYPAL_RECONCILE_SECRET" \
#         https://<dashboard>/api/paypal/reconcile
#     Leave blank to allow only the signed-in owner to trigger it by hand.
#     Generate with: openssl rand -hex 32
PAYPAL_RECONCILE_SECRET=
# Set to 1 to turn the in-dashboard reconciliation scheduler off entirely.
PAYPAL_RECONCILE_DISABLED=

# ── Optional: YouTube OAuth (for music) ─────────────────────
# Improves YouTube reliability. Get a refresh token from Lavalink's
# first-run OAuth URL (check Lavalink logs) or youfresh.thiranjaya.com
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Production Caddy (DOMAIN required by production Compose) ─
DOMAIN=
# Space-separated exact source CIDRs of any CDN/reverse proxy allowed to supply
# X-Forwarded-For to Caddy. Leave this TEST-NET-1 sentinel unchanged when clients
# connect directly to Caddy; it intentionally trusts no real production peer.
# If a CDN is placed in front, replace it with that provider's current published
# egress CIDRs. Never use 0.0.0.0/0, ::/0, or broad private-network ranges.
CADDY_TRUSTED_PROXY_CIDRS=192.0.2.0/24

# ── Optional: Supabase Management API / Auto-Migration ───────
# If set, the setup wizard can auto-configure Supabase Discord auth and the bot
# can try to run database migrations on first boot.
# Leave blank only if you configure Supabase auth/migrations manually.
SUPABASE_ACCESS_TOKEN=
# Set true only after manually enabling the Supabase Discord auth provider
# and adding each dashboard /api/auth/callback URL to the Supabase allow-list.
SUPABASE_DISCORD_AUTH_PROVIDER_CONFIGURED=false
SUPABASE_DB_URL=

# ── Optional: Connection Pooling (see docs/SCALING.md §9.4) ──
# Use the pooled connection string for multi-replica deployments.
# Supabase Dashboard → Settings → Database → Connection pooling (port 6543)
# SUPABASE_DB_URL_POOLED=postgresql://postgres.[ref]:[password]@[region]-pooler.supabase.com:6543/postgres?pgbouncer=true
