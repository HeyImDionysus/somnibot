# ============================================================
# SomniBot Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Discord
DISCORD_TOKEN=YOUR_DISCORD_TOKEN
DISCORD_APPLICATION_ID=YOUR_DISCORD_APP_ID
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID
DISCORD_PERMISSIONS=1428139040832

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_ACCESS_TOKEN

# PayPal (Sandbox)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_SANDBOX=true
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
PAYPAL_WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/paypal-webhook

# Lavalink
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=YOUR_LAVALINK_PASSWORD

# Valkey
VALKEY_URL=redis://127.0.0.1:6379

# Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# YouTube OAuth (for Lavalink — get refresh token from Lavalink first-run URL or youfresh.thiranjaya.com)
YOUTUBE_OAUTH_REFRESH_TOKEN=
