# ============================================================
# SomniBot Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Discord (REQUIRED) ──────────────────────────────────────
# Get these from https://discord.com/developers/applications
#   → Your app → Bot → Token
#   → Your app → OAuth2 → Client ID and Client Secret
#   → Your app → Bot → Enable all 3 Privileged Gateway Intents
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=

# ── Supabase (REQUIRED) ─────────────────────────────────────
# Get these from https://supabase.com/dashboard
#   → Your project → Settings → API
#   → Project URL and secret key (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Auto-Configured (usually don't need to change) ──────────
# Guild ID is auto-detected when the bot joins your server
DISCORD_GUILD_ID=

# Lavalink (music server) — defaults work with docker compose
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=

# Valkey (cache) — set VALKEY_PASSWORD for production
VALKEY_PASSWORD=
VALKEY_URL=redis://:${VALKEY_PASSWORD}@127.0.0.1:6379

# ── Dashboard ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Same as SUPABASE_URL above
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Optional: PayPal (for commerce features) ────────────────
# Get these from https://developer.paypal.com → Dashboard → Apps
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=

# ── Optional: YouTube OAuth (for music) ─────────────────────
# Improves YouTube reliability. Get a refresh token from Lavalink's
# first-run OAuth URL (check Lavalink logs) or youfresh.thiranjaya.com
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Optional: Production Domain (for Caddy HTTPS) ───────────
DOMAIN=

# ── Optional: Auto-Migration ────────────────────────────────
# If set, the bot auto-runs database migrations on first boot
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=

# ── Optional: Connection Pooling (see docs/SCALING.md §9.4) ──
# Use the pooled connection string for multi-replica deployments.
# Supabase Dashboard → Settings → Database → Connection pooling (port 6543)
# SUPABASE_DB_URL_POOLED=postgresql://postgres.[ref]:[password]@[region]-pooler.supabase.com:6543/postgres?pgbouncer=true
