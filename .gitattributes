# The generated DB-type snapshot is byte-compared in CI (type-drift gate).
# Pin it to LF so a Windows checkout with core.autocrlf=true cannot rewrite its
# line endings and produce a false drift against the Linux CI regeneration.
packages/shared/src/types/database.generated.ts text eol=lf

# The canonical E2E catalog is byte-exact-compared by catalog-data tests;
# keep it LF on every platform so Windows autocrlf cannot break the check.
/packages/e2e/catalog/v1.json text eol=lf
